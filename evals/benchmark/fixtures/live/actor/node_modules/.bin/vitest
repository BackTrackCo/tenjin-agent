#!/usr/bin/env node
import { spawnSync } from 'node:child_process';
const args = process.argv.slice(2);
if (args[0] !== 'run' || args.length !== 2) {
  console.error('usage: vitest run <one-file>');
  process.exit(2);
}
const child = spawnSync(process.execPath, [args[1]], { stdio: 'inherit' });
process.exit(child.status ?? 2);
