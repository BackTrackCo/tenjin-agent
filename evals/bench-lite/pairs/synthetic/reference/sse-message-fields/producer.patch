+/**
+ * Stream an iterable to the client as server-sent events.
+ *
+ * Each item becomes one message; the stream closes when the source is done.
+ */
+export async function sendEventStream(
+  event: H3Event,
+  source: Iterable<unknown> | AsyncIterable<unknown>,
+  opts?: EventStreamOptions,
+): Promise<void> {
+  const stream = new _EventStream(event, opts);
+
+  const pump = (async () => {
+    try {
+      for await (const item of source as AsyncIterable<unknown>) {
+        await stream.push(_asMessage(item));
+      }
+    } finally {
+      await stream.close();
+    }
+  })();
+
+  const sent = stream.send();
+  await Promise.all([pump, sent]);
+}
+
+/** An item is either a message with its own fields, or the payload itself. */
+function _asMessage(item: unknown): EventStreamMessage {
+  if (
+    item !== null &&
+    typeof item === "object" &&
+    "data" in (item as Record<string, unknown>)
+  ) {
+    return item as EventStreamMessage;
+  }
+  return { data: item };
+}
+
 export type EventStream = ReturnType<typeof createEventStream>;
 export type { EventStreamOptions, EventStreamMessage } from "./types";
