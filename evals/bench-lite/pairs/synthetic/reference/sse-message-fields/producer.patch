+/** A string payload goes out as it stands; anything else is JSON. */
+function _serializeData(data: unknown): string {
+  if (typeof data === "string") {
+    return data;
+  }
+  if (data === undefined) {
+    return "";
+  }
+  return JSON.stringify(data) ?? "";
+}
