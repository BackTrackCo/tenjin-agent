+import { getAccount } from '../accounts.ts';
+import { hasSeenKey, markKeySeen } from '../db/queries.ts';
+import { digest } from '../hash.ts';
+import { postEntry } from '../ledger.ts';
+import type { EntryKind } from '../types.ts';
+
+/** One row of a customer day file, already parsed. */
+export interface ImportRow {
+  amountCents: number | string;
+  kind: EntryKind;
+  memo?: string;
+  reference?: string;
+}
+
+/** What one import call took and what it left. */
+export interface ImportSummary {
+  received: number;
+  imported: number;
+  duplicates: number;
+  keys: string[];
+}
+
+const NAMESPACE = 'import';
+
+/** The dedupe key for one row on one account. */
+export function rowKey(accountId: string, row: ImportRow): string {
+  return digest([accountId, JSON.stringify(row)], { salt: NAMESPACE });
+}
+
+function amountOf(row: ImportRow): number {
+  return typeof row.amountCents === 'string' ? Number(row.amountCents) : row.amountCents;
+}
+
+/** Post the rows this account has not taken before. */
+export function importRows(accountId: string, rows: ImportRow[]): ImportSummary {
+  getAccount(accountId);
+
+  const keys: string[] = [];
+  let duplicates = 0;
+
+  for (const row of rows) {
+    const key = rowKey(accountId, row);
+    if (hasSeenKey(NAMESPACE, key)) {
+      duplicates += 1;
+      continue;
+    }
+    postEntry({
+      accountId,
+      amountCents: amountOf(row),
+      kind: row.kind,
+      memo: row.memo ?? '',
+    });
+    markKeySeen(NAMESPACE, key);
+    keys.push(key);
+  }
+
+  return { received: rows.length, imported: keys.length, duplicates, keys };
+}
