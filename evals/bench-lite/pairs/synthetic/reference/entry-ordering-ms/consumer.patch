+export interface EntryWindow {
+  since?: string;
+  until?: string;
+}
+
+function windowBound(value: string | undefined): number | null {
+  if (value === undefined) {
+    return null;
+  }
+  const parsed = value.trim() === '' ? Number.NaN : new Date(value).getTime();
+  if (Number.isNaN(parsed)) {
+    throw badRequest('invalid_window', `not an ISO-8601 instant: ${value}`);
+  }
+  return parsed;
+}
+
+/** The entries on an account inside a time window, oldest first. */
+export function listEntriesInWindow(accountId: string, window: EntryWindow): Entry[] {
+  getAccount(accountId);
+  const since = windowBound(window.since);
+  const until = windowBound(window.until);
+
+  return listEntryRows(accountId)
+    .filter(
+      (row) =>
+        (since === null || row.createdAtMs >= since) &&
+        (until === null || row.createdAtMs < until),
+    )
+    .map(rowToEntry);
+}
