diff --git a/src/commands/reconcile.ts b/src/commands/reconcile.ts
new file mode 100644
index 0000000..fc90121
--- /dev/null
+++ b/src/commands/reconcile.ts
@@ -0,0 +1,48 @@
+import { getAccount } from '../accounts.ts';
+import { recordAudit } from '../audit.ts';
+import { beginRequest } from '../context.ts';
+import { db } from '../db/queries.ts';
+import { balanceFor, settleEntry } from '../ledger.ts';
+
+/** What one reconcile run found and did. */
+export interface ReconcileSummary {
+  accountId: string;
+  checked: number;
+  settled: number;
+  unsettled: number;
+  balanceCents: number;
+}
+
+/** Settle whatever is still open on one account and report the numbers. */
+export async function reconcileAccount(accountId: string): Promise<ReconcileSummary> {
+  getAccount(accountId);
+
+  return beginRequest(
+    { source: 'cli', accountId },
+    async (): Promise<ReconcileSummary> => {
+      recordAudit({ action: 'reconcile.started', accountId, detail: {} });
+
+      const rows = db.entries.filter((row) => row.accountId === accountId);
+      let settled = 0;
+      for (const row of rows) {
+        if (!row.settled) {
+          settleEntry(row.id);
+          settled += 1;
+        }
+      }
+
+      const balanceCents = balanceFor(accountId).balanceCents;
+      const unsettled = db.entries.filter(
+        (row) => row.accountId === accountId && !row.settled,
+      ).length;
+
+      recordAudit({
+        action: 'reconcile.finished',
+        accountId,
+        detail: { checked: rows.length, settled, balanceCents },
+      });
+
+      return { accountId, checked: rows.length, settled, unsettled, balanceCents };
+    },
+  );
+}
