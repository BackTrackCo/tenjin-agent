+/**
+ * Feature flags, read at the moment they are asked about.
+ *
+ * Ops flip `LEDGER_FLAGS` on a running process, so a flag has to be read when
+ * the work happens rather than kept from whenever this module first loaded.
+ */
+
+/** The flags set right now, trimmed, in the order they were written. */
+export function currentFlags(): string[] {
+  return (process.env.LEDGER_FLAGS ?? '')
+    .split(',')
+    .map((flag) => flag.trim())
+    .filter((flag) => flag.length > 0);
+}
+
+/** True if `name` is one of the flags set right now. */
+export function isFlagOn(name: string): boolean {
+  return currentFlags().includes(name);
+}
