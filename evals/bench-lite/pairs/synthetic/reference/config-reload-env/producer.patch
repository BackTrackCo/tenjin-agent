+/** Read the environment as it stands right now. */
+function readConfig(): LedgerConfig {
+  const env = process.env;
+  return Object.freeze({
+    currency: env.LEDGER_CURRENCY ?? 'USD',
+    maxBatchSize: readInt(env.LEDGER_MAX_BATCH, 50),
+    retentionDays: readInt(env.LEDGER_RETENTION_DAYS, 90),
+    flags: Object.freeze(readFlags(env.LEDGER_FLAGS)),
+    strictAmounts: env.LEDGER_STRICT_AMOUNTS === '1',
+  });
+}
+
+let current: LedgerConfig = readConfig();
+
+/** The configuration in force now. */
+export function getConfig(): LedgerConfig {
+  return current;
+}
+
+/** Re-read the environment and adopt it. */
+export function reloadConfig(): LedgerConfig {
+  current = readConfig();
+  return current;
+}
 
