@@ -6,13 +6,16 @@ import { PRICING_TABLE } from './table.generated.ts';
 export interface PriceCell {
   flatCents: number;
   basisPoints: number;
+  /** Discount above a threshold, or null where none applies. */
+  tier: { aboveCents: number; discountBasisPoints: number } | null;
 }
 
-const EMPTY_CELL: PriceCell = { flatCents: 0, basisPoints: 0 };
+const EMPTY_CELL: PriceCell = { flatCents: 0, basisPoints: 0, tier: null };
 
 /** The cell that prices this plan and entry kind. */
 export function cellFor(plan: Plan, kind: EntryKind): PriceCell {
-  return PRICING_TABLE[cellKey(plan, kind)] ?? EMPTY_CELL;
+  const cell = PRICING_TABLE[cellKey(plan, kind)];
+  return cell ? { ...EMPTY_CELL, ...cell } : EMPTY_CELL;
 }
 
 /**
@@ -22,7 +25,10 @@ export function cellFor(plan: Plan, kind: EntryKind): PriceCell {
  */
 export function priceFor(plan: Plan, kind: EntryKind, amountCents: number): number {
   const cell = cellFor(plan, kind);
-  const fee = cell.flatCents + (amountCents * cell.basisPoints) / 10_000;
+  let fee = cell.flatCents + (amountCents * cell.basisPoints) / 10_000;
+  if (cell.tier && amountCents > cell.tier.aboveCents) {
+    fee = (fee * (10_000 - cell.tier.discountBasisPoints)) / 10_000;
+  }
   return Math.max(0, Math.round(fee));
 }
 
