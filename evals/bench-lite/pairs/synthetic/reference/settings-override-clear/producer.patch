+/** Every field an account may carry an override for. */
+export const SETTINGS_FIELDS: readonly (keyof AccountSettings)[] = [
+  'spendingLimitCents',
+  'notifyEmail',
+  'autoSettle',
+  'statementDay',
+];
+
+function asSettingsField(field: string): keyof AccountSettings {
+  const known = SETTINGS_FIELDS.find((name) => name === field);
+  if (!known) {
+    throw badRequest('invalid_field', `not a settings field: ${field}`);
+  }
+  return known;
+}
+
+export interface SettingsPatchResult {
+  settings: AccountSettings;
+  version: number;
+  cleared: string[];
+}
+
+/**
+ * Set some overrides and take others off, in one write.
+ *
+ * One call is one version, however many fields it touched.
+ */
+export function applySettingsPatch(
+  accountId: string,
+  set: SettingsOverrides,
+  reset: readonly string[],
+): SettingsPatchResult {
+  const row = getAccountRow(accountId);
+  if (!row) {
+    throw notFound('account_not_found', `no such account: ${accountId}`);
+  }
+  const clean = validateOverrides(set);
+  const names = reset.map(asSettingsField);
+
+  const overrides: SettingsOverrides = { ...row.overrides, ...clean };
+  const cleared: string[] = [];
+  for (const name of names) {
+    if (name in overrides) {
+      delete overrides[name];
+      cleared.push(name);
+    }
+  }
+
+  const next = replaceAccountOverrides(accountId, overrides);
+
+  if (Object.keys(clean).length > 0) {
+    recordAudit({
+      action: 'settings.updated',
+      accountId,
+      detail: { version: next.version, fields: Object.keys(clean).sort().join(',') },
+    });
+  }
+  if (cleared.length > 0) {
+    recordAudit({
+      action: 'settings.cleared',
+      accountId,
+      detail: { version: next.version, fields: [...cleared].sort().join(',') },
+    });
+  }
+
+  return {
+    settings: resolveSettings(accountId),
+    version: next.version,
+    cleared: [...cleared].sort(),
+  };
+}
+
+/** Take this account's override off the named fields. */
+export function clearSettingsOverrides(accountId: string, fields: string[]): AccountSettings {
+  return applySettingsPatch(accountId, {}, fields).settings;
+}
+
 /** Every settings version ever written for this account, oldest first. */
 export function listSettingsVersions(accountId: string): SettingsVersion[] {
   return listSettingsVersionRows(accountId).map(rowToSettingsVersion);
