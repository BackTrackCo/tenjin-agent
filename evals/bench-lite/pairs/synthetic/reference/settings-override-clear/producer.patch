+/**
+ * Replace this account's override set wholesale, bump the version, and keep a
+ * copy of the result in `settingsVersions`.
+ *
+ * Unlike `updateAccountOverrides` this is not a layering: what is passed in is
+ * what the account ends up with, so it is the path for a write that has to be
+ * able to take a key away.
+ */
+export function replaceAccountOverrides(
+  accountId: string,
+  overrides: SettingsOverrides,
+): AccountRow {
+  const current = db.accounts.get(accountId);
+  if (!current) {
+    throw new Error(`no such account: ${accountId}`);
+  }
+  const next = db.accounts.update(accountId, {
+    overrides: { ...overrides },
+    version: current.version + 1,
+  });
+  writeSettingsVersion(next);
+  return next;
+}
+
 export function listSettingsVersionRows(accountId: string): SettingsVersionRow[] {
   return db.settingsVersions
     .filter((row) => row.accountId === accountId)
