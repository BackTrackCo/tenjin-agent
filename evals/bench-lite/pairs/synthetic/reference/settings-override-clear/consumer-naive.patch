+/** Put this account's settings back to the override set `toVersion` held. */
+export function revertSettings(accountId: string, toVersion: number): AccountSettings {
+  const row = getAccountRow(accountId);
+  if (!row) {
+    throw notFound('account_not_found', `no such account: ${accountId}`);
+  }
+  const target = getSettingsVersion(accountId, toVersion);
+  const next = updateAccountOverrides(accountId, target.overrides);
+  recordAudit({
+    action: 'settings.reverted',
+    accountId,
+    detail: { from: row.version, to: toVersion, version: next.version },
+  });
+  return resolveSettings(accountId);
+}
+
