+/**
+ * An event handler that answers the request from `target`.
+ *
+ * The path the handler was reached at is appended to the target, so a handler
+ * mounted at `/api` sends `/api/things` to `<target>/things`.
+ */
+export function proxyEventHandler(
+  target: string,
+  opts: ProxyOptions = {},
+): EventHandler {
+  const base = target.endsWith("/") ? target.slice(0, -1) : target;
+  return eventHandler((event) =>
+    proxyRequest(event, base + (event.path || "/"), opts),
+  );
+}
