{
  "name": "tenjin-cli",
  "version": "0.1.0-alpha.34",
  "type": "module",
  "description": "The tool router for coding agents. Tenjin picks the right tool when your agent needs one, and one wallet pays for every call.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BackTrackCo/tenjin-agent.git"
  },
  "homepage": "https://tenjin.sh/agents",
  "bugs": "https://github.com/BackTrackCo/tenjin-agent/issues",
  "keywords": [
    "claude-code",
    "coding-agents",
    "tool-router",
    "ai-agents",
    "agent-tools",
    "mcp",
    "x402",
    "usdc",
    "base",
    "micropayments",
    "agent-payments",
    "claude",
    "codex",
    "cli"
  ],
  "bin": {
    "tenjin": "dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "tenjinRuntime": {
    "node": {
      "version": "24.22.3",
      "sha256": {
        "darwin-arm64": "ff6e17d4874b76d272212b908cc020d6e815fba5a6c7eaaa06add725840307fd",
        "darwin-x64": "977614af0504c81045e7fd85596dbca0e5f951b96681516dadafedcca8c447f7",
        "linux-x64": "061ec3e3062115705b56b51fa9cc330ab50d34b6969387d4e4b1a50c6809acc2",
        "linux-arm64": "261af2af250dfd7e9f25cf151d1b2713a0adf8f10a9ad116c4947f68627affe8",
        "win-x64": "e612af99f626ab415ea225af6bce5c971feb448cb5cae250bb1c3fa50c5f7d9f",
        "win-arm64": "b3cc74a295b39d4f273271e96f58c06dd2b35757ca12abec64c7d0598b434f14"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "scripts/installers",
    "NOTICE.md"
  ],
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "rm -rf dist .bundle-meta && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run build && pnpm run test",
    "pack-smoke": "bash scripts/pack-smoke.sh",
    "changeset": "changeset",
    "prepublishOnly": "pnpm run build",
    "githooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.325",
    "@anthropic-ai/sdk": "0.137.0",
    "@changesets/cli": "^3.0.3",
    "@clack/prompts": "^1.7.0",
    "@eslint/js": "^10",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@types/node": "^22.20.5",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/extensions": "2.28.0",
    "@x402/fetch": "2.28.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.1",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "hash-wasm": "4.12.0",
    "lean-qr": "^2.7.4",
    "ox": "0.14.30",
    "prettier": "^3",
    "tsup": "^8.5.0",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "viem": "^2.53.1",
    "vitest": "^4.1.9",
    "zod": "^4.6.6"
  }
}
