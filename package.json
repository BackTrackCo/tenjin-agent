{
  "name": "tenjin-cli",
  "version": "0.1.0-alpha.32",
  "type": "module",
  "description": "The tool router for coding agents. Tenjin picks the right tool when your agent needs one, and one wallet pays for every call.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BackTrackCo/tenjin-agent.git"
  },
  "homepage": "https://tenjin.sh/agents",
  "bugs": "https://github.com/BackTrackCo/tenjin-agent/issues",
  "keywords": [
    "claude-code",
    "coding-agents",
    "tool-router",
    "ai-agents",
    "agent-tools",
    "mcp",
    "x402",
    "usdc",
    "base",
    "micropayments",
    "agent-payments",
    "claude",
    "codex",
    "cli"
  ],
  "bin": {
    "tenjin": "dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "tenjinRuntime": {
    "node": {
      "version": "24.22.1",
      "sha256": {
        "darwin-arm64": "89c682593d76cd44233fa53b1563264e7de9cbb189cad169135c5b4fadfbc0a7",
        "darwin-x64": "d132557e7ee2b85af08b0c8c34338e65c6430f2238d01f727728ef42dc83b035",
        "linux-x64": "eb6728e77c576a35162c122c45ccadf224d89ff00abc8dae46cc2897c6002d7c",
        "linux-arm64": "33c37be234ba8bee041961047b19160f4d7d0f164e8e246f78bdd10feff148b3",
        "win-x64": "d2046d28c2c3dcd211ac5145c0bf30e2047ef9dfb306693c8c6e2eccd8b95fa5",
        "win-arm64": "a0c807319fede24c4a0d8f84564c82a619bd313b16b10c007c383c2609e99171"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "NOTICE.md"
  ],
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run build && pnpm run test",
    "sync:skill": "node scripts/sync-skill.mjs",
    "pack-smoke": "bash scripts/pack-smoke.sh",
    "changeset": "changeset",
    "prepublishOnly": "pnpm run build",
    "githooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@clack/prompts": "^1.7.0",
    "@eslint/js": "^10",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@types/node": "^22.20.5",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/extensions": "2.28.0",
    "@x402/fetch": "2.28.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.1",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "lean-qr": "^2.7.4",
    "ox": "0.14.30",
    "prettier": "^3",
    "tsup": "^8.5.0",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "viem": "^2.53.1",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  }
}
