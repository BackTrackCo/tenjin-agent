#!/usr/bin/env bash
set -euo pipefail

# Local mirror of the CI Prettier gate. Wired by the package.json "githooks"
# script (`pnpm githooks` sets git config core.hooksPath .githooks).
echo "tenjin-agent pre-commit: prettier format check"
if ! pnpm format:check; then
  echo
  echo "✗ Prettier found unformatted files. Run 'pnpm format', re-stage, then commit again."
  exit 1
fi
