#!/usr/bin/env bash
set -euo pipefail

# Local mirror of two CI gates: the generated-guidance integrity check and the
# Prettier check. Auto-wired by the package.json "prepare" script (sets
# git config core.hooksPath .githooks on install).
echo "tenjin-agent pre-commit: generated workspace guidance"
node scripts/check-workspace-adapters.mjs

echo "tenjin-agent pre-commit: prettier format check"
if ! pnpm format:check; then
  echo
  echo "✗ Prettier found unformatted files. Run 'pnpm format', re-stage, then commit again."
  exit 1
fi
