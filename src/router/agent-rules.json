  "criteria": {
    "work": {
      "keep": "Run it as the parent asked. Prefer this when the work is hard to check, touches money, security, signing, migrations or a public contract, or when unsure.",
      "bounded-lookup": "A bounded lookup with a clear end: find files, definitions, usages or one fact and say where they are.",
      "routine-analysis": "Follow a feature across modules, summarise or compare what code or docs say, run a written mechanical procedure or apply a fully specified change, or research a topic on the web and report sources.",
      "hard-judgment": "Design, review, debugging with an unknown cause, or work where a wrong answer is costly and hard to check.",
      "repo-question": "Answer one question about this repository by reading its files, with file references, changing nothing, with no follow-up expected."
    },
    "effort": {
      "keep": "Run it at the effort the parent asked for. Prefer this when unsure.",
      "low": "Mechanical and well specified.",
      "medium": "Ordinary work in a known pattern.",
      "high": "Planning across files, or subtle logic.",
      "xhigh": "Hard design or debugging where a wrong answer is costly."
    }
  },
  "destinations": {
