        "capabilityId": "apify.google-maps-places",
        "provider": "Apify",
        "label": "Apify Google Maps",
        "holds": {},
        "output": "json",
        "description": "Google Maps places for a search, each with its name, address, phone, website and rating",
        "source": "apify",
        "mcp": {
          "tool": "call-actor",
          "args": {
            "actor": "compass/crawler-google-places",
            "input": {
              "searchStringsArray": ["{query}"],
              "locationQuery": "{location}",
              "maxCrawledPlacesPerSearch": "{limit}",
              "language": "en"
            },
            "callOptions": {
              "maxTotalChargeUsd": 0.5
            }
          },
          "result": "structured",
          "next": {
            "poll": {
              "tool": "get-actor-run",
              "args": {
                "runId": "{result.runId}"
              },
              "result": "structured",
              "running": {
                "path": "status",
                "values": ["READY", "RUNNING"]
              },
              "failed": {
                "path": "status",
                "values": ["FAILED", "TIMING-OUT", "TIMED-OUT", "ABORTING", "ABORTED"]
              },
              "everyS": 5,
              "maxWaitS": 300
            },
            "tool": "get-dataset-items",
            "args": {
              "datasetId": "{result.storages.datasets.default.id}",
              "limit": "{limit}",
              "fields": "title,address,phone,website,totalScore",
              "clean": true
            },
            "result": "structured"
          }
        },
        "input": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "What to search for, such as coffee shops."
            },
            "location": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Where to search: a city, region or address."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "How many places, at most 50."
            }
          },
          "required": ["query", "limit"],
          "additionalProperties": false
        },
        "pinned": {},
        "example": {
          "query": "coffee shops",
          "location": "Austin, TX",
          "limit": 20
        },
        "returns": "the places found, each with its name, address, phone, website and rating",
        "resultSchema": {
          "type": "object",
          "required": ["items"]
        },
        "requires": ["mcp"]
      }
    ],
