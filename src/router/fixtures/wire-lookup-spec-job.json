    "spec": {
      "capabilityId": "aispace-hailuo-3-max",
      "provider": "AiSpace (Venice) (MiniMax Hailuo 3 Max)",
      "holds": {},
      "output": "media",
      "description": "Cinematic 5-second clips with native audio from a prompt, at 768p: launch, product and social videos (model=\"minimax-h3-max-text-to-video\"). $0.155 is AiSpace's promo price, half its $0.31 list.",
      "priceAtomic": "155000",
      "priceVaries": false,
      "maxAmountAtomic": "155000",
      "payTo": "0xA7f3Ad0E69F61864092FAbBa6Cee00AF6e584689",
      "network": "eip155:8453",
      "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
      "request": {
        "method": "POST",
        "url": "https://x402.aispace.bot/api/v1/video/queue",
        "fields": {
          "model": "body",
          "prompt": "body",
          "duration": "body",
          "resolution": "body",
          "aspect_ratio": "body"
        },
        "location": "body"
      },
      "input": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "Venice video model id.",
            "enum": ["minimax-h3-max-text-to-video"],
            "default": "minimax-h3-max-text-to-video"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "What the video should show, and how the camera moves."
          },
          "duration": {
            "type": "string",
            "enum": ["5s"],
            "description": "5 s ($0.155); longer clips cost more"
          },
          "resolution": {
            "type": "string",
            "enum": ["768P"]
          },
          "aspect_ratio": {
            "type": "string",
            "enum": ["16:9", "21:9", "4:3", "1:1", "3:4", "9:16"],
            "description": "Frame shape; 9:16 for a vertical video"
          }
        },
        "required": ["model", "prompt", "duration", "resolution"],
        "additionalProperties": false
      },
      "pinned": {
        "model": "minimax-h3-max-text-to-video",
        "duration": "5s",
        "resolution": "768P"
      },
