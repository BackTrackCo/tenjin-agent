{
  "schemaVersion": 1,
  "routerVersion": "2026-11-04.2",
  "decision": {
    "action": "spec",
    "id": "0195f3a1-6c4d-7a2b-9e10-5f6a7b8c9d40",
    "spec": {
      "capabilityId": "fal.flux-pro-ultra",
      "provider": "fal",
      "label": "fal FLUX1.1 Pro Ultra",
      "holds": {},
      "output": "media",
      "description": "one photoreal image from a text prompt, made by FLUX1.1 [pro] ultra",
      "source": "fal",
      "mcp": {
        "tool": "run_model",
        "args": {
          "endpoint_id": "fal-ai/flux-pro/v1.1-ultra",
          "input": {
            "prompt": "{prompt}",
            "aspect_ratio": "{aspect_ratio}",
            "num_images": 1,
            "output_format": "jpeg"
          }
        },
        "result": "json-text",
        "next": {
          "when": {
            "path": "status",
            "values": ["processing"]
          },
          "poll": {
            "tool": "check_job",
            "args": {
              "endpoint_id": "fal-ai/flux-pro/v1.1-ultra",
              "request_id": "{result.request_id}"
            },
            "result": "json-text",
            "running": {
              "path": "status",
              "values": ["IN_QUEUE", "IN_PROGRESS"]
            },
            "everyS": 3,
            "maxWaitS": 180
          },
          "tool": "get_job_result",
          "args": {
            "endpoint_id": "fal-ai/flux-pro/v1.1-ultra",
            "request_id": "{result.request_id}"
          },
          "result": "json-text"
        }
      },
      "input": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "What the image shows."
          },
          "aspect_ratio": {
            "type": "string",
            "enum": ["1:1", "4:3", "3:4", "16:9", "9:16"],
            "description": "The shape of the image."
          }
        },
        "required": ["prompt"],
        "additionalProperties": false
      },
      "pinned": {},
      "example": {
        "prompt": "a lighthouse at dusk, 35mm photo",
        "aspect_ratio": "16:9"
      },
      "returns": "one image, saved to a file",
      "requires": ["mcp"]
    },
    "hint": "Call request({id: \"0195f3a1-6c4d-7a2b-9e10-5f6a7b8c9d40\", input: {\"prompt\":\"<what the image shows>\"}}) alone and wait for its result."
  },
  "jev": {
    "calls": 0,
    "latencyMs": 0
  },
  "honored": ["schemaVersion", "tool", "accepts", "harness", "settings"],
  "settingsHash": "sha256:06e2c79f2d8d7eb6fb8f4df109007f446a39c273606b03f7d00a1edfc2874c59"
}
